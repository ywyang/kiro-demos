# Gost 代理服务环境变量配置
# 复制此文件为 .env 并修改配置

# ============== 端口配置 ==============
# HTTP 代理端口
HTTP_PROXY_PORT=8080

# Gost UI Web 管理界面端口
GOST_UI_PORT=3000

# Gost API 端口（供 UI 连接）
GOST_API_PORT=18080

# ============== API 认证 ==============
# Gost API 管理接口认证（用于 Web UI 连接）
GOST_API_USER=admin
GOST_API_PASS=changeMe!2024

# ============== 日志级别 ==============
# 可选: debug, info, warn, error
LOG_LEVEL=info
